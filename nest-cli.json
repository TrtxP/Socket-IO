{
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "assets": [
      "**/*.ejs",
      "**/*.html",
      "**/*.css",
      "**/*.jpg",
      "**/*.png",
      "js/**/*.js",
      "login/**/*.js",
      "register/**/*.js",
      "reset-password/**/*.js"
    ],
    "watchAssets": true
  }
}